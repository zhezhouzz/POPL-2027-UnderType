/span><span class=3D"katex-html" aria-hidden=3D"true"><span class=3D"base">=
<span class=3D"strut" style=3D"height:0.4306em;"></span><span class=3D"mord=
 mathnormal">e</span><span class=3D"mspace" style=3D"margin-right:0.2778em;=
"></span><span class=3D"mrel">:</span><span class=3D"mspace" style=3D"margi=
n-right:0.2778em;"></span></span><span class=3D"base"><span class=3D"strut"=
 style=3D"height:0.4306em;"></span><span class=3D"mord mathnormal" style=3D=
"margin-right:0.1132em;">=CF=84</span></span></span></span></span> holds if=
 <span class=3D"" data-katex-src=3D"e"><span class=3D"katex"><span class=3D=
"katex-mathml"><math xmlns=3D"http://www.w3.org/1998/Math/MathML"><semantic=
s><mrow><mi>e</mi></mrow><annotation encoding=3D"application/x-tex">e</anno=
tation></semantics></math></span><span class=3D"katex-html" aria-hidden=3D"=
true"><span class=3D"base"><span class=3D"strut" style=3D"height:0.4306em;"=
